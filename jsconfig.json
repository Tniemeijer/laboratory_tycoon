{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "checkJs": true,
        "strict": false,
        "noImplicitAny": false,
        "allowJs": true,
        "baseUrl": ".",
        "paths": { "three": ["node_modules/three"], "three/*": ["node_modules/three/*"] }
    },
    "include": ["src/**/*.js"],
    "exclude": ["node_modules", "dist"]
}
